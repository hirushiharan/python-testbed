# Copy this file to .env and replace placeholder values.

# AI Providers

# Anthropic chat
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# OpenRouter chat
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-4.6-opus

# Google model listing
GOOGLE_API_KEY=your_google_api_key_here

# Outlook mailbox retrieval via Microsoft Graph
OUTLOOK_TENANT_ID=your_azure_tenant_id_here
OUTLOOK_CLIENT_ID=your_azure_app_client_id_here
OUTLOOK_CLIENT_SECRET=your_azure_app_client_secret_here
OUTLOOK_MAILBOX=mailbox_user_or_upn_here

# AWS credentials (required for S3 delete utility)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=
AWS_REGION=your_aws_region_here

# Auth module
ENTRA_TENANT_ID=your_entra_tenant_id_here
ENTRA_CLIENT_ID=your_entra_client_id_here
ENTRA_CLIENT_SECRET=your_entra_client_secret_here
ENTRA_AUDIENCE=api://your_entra_client_id_here
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
ENTRA_AUTH_SCOPES=openid,profile,email,offline_access
ENTRA_REQUIRED_SCOPES=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=python_testbed
MYSQL_USER=your_mysql_user_here
MYSQL_PASSWORD=your_mysql_password_here
# Optional full SQLAlchemy URL override:
# SQLALCHEMY_DATABASE_URL=mysql+pymysql://user:pass@host:3306/db
